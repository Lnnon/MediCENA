# Copy to .env for local use, or set these in the Render dashboard.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Application records. SQLite is the local default.
DJANGO_DB_ENGINE=django.db.backends.sqlite3
# DJANGO_DB_NAME=postgres
# DJANGO_DB_USER=
# DJANGO_DB_PASSWORD=
# DJANGO_DB_HOST=
# DJANGO_DB_PORT=5432
# DJANGO_DB_SSLMODE=require

# GIS database. Leave DB_NAME unset to omit the GIS connection.
# DB_NAME=MEDIFLOW
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432
# DJANGO_GIS_DB_SSLMODE=require

# Optional delivery providers.
# DJANGO_EMAIL_HOST=
# DJANGO_EMAIL_HOST_USER=
# DJANGO_EMAIL_HOST_PASSWORD=
# DJANGO_DEFAULT_FROM_EMAIL=
SMS_PROVIDER=disabled
